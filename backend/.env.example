###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root@127.0.0.1:3306/mealmates?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# En dev, aucun mail n'est réellement envoyé :
MAILER_DSN=null://null
# En prod, DSN SMTP réel, ex :
# MAILER_DSN=smtp://username:password@smtp.gmail.com:587
###< symfony/mailer ###

# Client ID OAuth Google, utilisé par ApiUserController::ssoUsers() pour
# vérifier l'ID token reçu du frontend. Doit être identique à
# VITE_APP_GOOGLE_CLIENT_ID côté frontend/.env.
CLIENT_ID_GOOGLE=

###> stripe ###
# Clé secrète Stripe (mode test recommandé en dev), utilisée par ApiPaymentController.
STRIPE_SECRET_KEY=
# URL du frontend, utilisée dans les redirections Stripe après paiement.
FRONT_LINK=http://localhost:5173
###< stripe ###
