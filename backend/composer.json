{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",

        "api-platform/doctrine-orm": "^4.3.16",
        "api-platform/symfony": "^4.3.15",

        "cocur/slugify": "^4.7.1",

        "doctrine/dbal": "^3.10.5",
        "doctrine/doctrine-bundle": "^2.18.3",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.7",

        "endroid/qr-code": "^4.8.5",

        "google/apiclient": "^2.19.4",

        "lexik/jwt-authentication-bundle": "^3.2",

        "nelmio/api-doc-bundle": "^5.10.3",
        "nelmio/cors-bundle": "^2.6.1",

        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.2",

        "spatie/array-to-xml": "^3.4.4",
        "stripe/stripe-php": "^17.6",

        "symfony/asset": "^7.4.8",
        "symfony/cache": "^7.4.14",
        "symfony/clock": "^7.4.8",
        "symfony/console": "^7.4.14",
        "symfony/dotenv": "^7.4.14",
        "symfony/expression-language": "^7.4.14",
        "symfony/flex": "^2.11",
        "symfony/form": "^7.4.14",
        "symfony/framework-bundle": "^7.4.14",
        "symfony/http-client": "^7.4.14",
        "symfony/mailer": "^7.4.14",
        "symfony/mailtrap-mailer": "^7.4.12",
        "symfony/messenger": "^7.4.14",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/property-access": "^7.4.8",
        "symfony/property-info": "^7.4.8",
        "symfony/runtime": "^7.4.14",
        "symfony/scheduler": "^7.4.13",
        "symfony/security-bundle": "^7.4.14",
        "symfony/security-core": "^7.4.14",
        "symfony/serializer": "^7.4.14",
        "symfony/twig-bundle": "^7.4.14",
        "symfony/validator": "^7.4.14",
        "symfony/yaml": "^7.4.14",

        "symfonycasts/verify-email-bundle": "^1.18",

        "twig/twig": "^3.27.1",

        "vich/uploader-bundle": "^2.9.4"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "fakerphp/faker": "^1.24.1",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/maker-bundle": "^1.67",
        "symfony/web-profiler-bundle": "^7.4.14"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "7.4.*"
        }
    }
}
