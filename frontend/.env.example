#development
VITE_API_BASE_URL=https://127.0.0.1:8000

# OAuth Google (SSO) — doit être identique à CLIENT_ID_GOOGLE côté backend/.env
VITE_APP_GOOGLE_CLIENT_ID=

# Clé API Google Maps (Maps JavaScript API + Geocoding API activées).
# Sans elle, la carte des offres et le géocodage d'adresse sont indisponibles.
VITE_GOOGLE_MAP=

# Clé AES du cache IndexedDB du profil utilisateur — générer une valeur
# aléatoire longue par environnement (ex: openssl rand -hex 32).
VITE_CRYPTO_KEY=
